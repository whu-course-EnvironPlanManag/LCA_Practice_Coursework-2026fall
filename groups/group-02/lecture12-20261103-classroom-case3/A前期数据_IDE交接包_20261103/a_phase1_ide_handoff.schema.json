{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A phase-one IDE data handoff schema 1.0.0",
  "type": "object",
  "required": [
    "dataset",
    "conventions",
    "case_definition",
    "sources",
    "source_aliases",
    "baseline_inputs",
    "composition_profiles",
    "candidate_process_parameters",
    "reference_literature_parameters",
    "reference_policies",
    "evidence_register",
    "unresolved_inputs",
    "calculation_gates",
    "integration_notes",
    "ide_bootstrap_instructions",
    "data_dictionary"
  ],
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "type": "object",
      "required": [
        "schema_version",
        "coding_ready",
        "full_process_model_ready",
        "model_executed"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "coding_ready": {
          "const": true
        },
        "full_process_model_ready": {
          "const": false
        },
        "model_executed": {
          "const": false
        }
      }
    },
    "conventions": {
      "type": "object"
    },
    "case_definition": {
      "type": "object"
    },
    "sources": {
      "type": "array"
    },
    "source_aliases": {
      "type": "object"
    },
    "baseline_inputs": {
      "type": "object"
    },
    "composition_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/composition"
      }
    },
    "candidate_process_parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "reference_literature_parameters": {
      "type": "array"
    },
    "reference_policies": {
      "type": "array"
    },
    "evidence_register": {
      "type": "array"
    },
    "unresolved_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pending"
      }
    },
    "calculation_gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "integration_notes": {
      "type": "array"
    },
    "ide_bootstrap_instructions": {
      "type": "string"
    },
    "data_dictionary": {
      "type": "object"
    }
  },
  "$defs": {
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "component": {
      "type": "object",
      "required": [
        "component_id",
        "component_name",
        "mass_fraction",
        "original_mass_percent",
        "source_ids",
        "evidence_ids"
      ],
      "properties": {
        "mass_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "original_mass_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        }
      }
    },
    "composition": {
      "type": "object",
      "required": [
        "profile_id",
        "physical_basis",
        "complete_partition",
        "eligible_for_received_component_inventory",
        "normalize_to_one",
        "components"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "complete_partition": {
          "type": "boolean"
        },
        "normalize_to_one": {
          "const": false
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "parameter_id",
        "active",
        "usable_for_calculation",
        "value",
        "numerator_unit",
        "denominator_unit",
        "feed_or_product_basis",
        "source_ids",
        "evidence_ids"
      ],
      "properties": {
        "parameter_id": {
          "type": "string"
        },
        "active": {
          "const": false
        },
        "usable_for_calculation": {
          "const": false
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "specification_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        }
      }
    },
    "pending": {
      "type": "object",
      "required": [
        "input_id",
        "key",
        "value",
        "status",
        "required_for"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "pattern": "^M[0-9]{2}$"
        },
        "value": {
          "type": "null"
        },
        "status": {
          "const": "unresolved"
        },
        "required_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "module",
        "ready",
        "blocking_input_ids",
        "allowed_work"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "blocking_input_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M[0-9]{2}$"
          }
        }
      }
    }
  }
}